{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gemini",
  "version": "1.0.0",
  "identifier": "com.gemini.tauri.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Gemini",
        "width": 420,
        "height": 860,
        "minWidth": 320,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
